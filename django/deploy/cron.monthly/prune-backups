#!/bin/sh

LOGFILE=/shared/logs/comses-backup.log
exec >>"$LOGFILE" 2>&1

# shellcheck disable=SC1091
. /code/deploy/cron.common

export DJANGO_SETTINGS_MODULE="core.settings.production"

printf '%s prune start: INV_BIN=%s\n' "$(date -Iseconds)" "$INV_BIN"
if [ ! -x "$INV_BIN" ]; then
    printf '%s ERROR: inv missing or not executable at %s\n' "$(date -Iseconds)" "$INV_BIN"
    exit 127
fi

exec "$INV_BIN" -r /code borg.prune
