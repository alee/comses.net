/srv/logs/comses/comsesnet.log /srv/logs/comses/django.log /srv/logs/comses/uwsgi.log {
    rotate 8
    maxsize 50M
    dateext
    weekly
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        cd /srv/apps/comses && docker compose exec -T server touch /code/core/wsgi.py
    endscript
}

/srv/logs/comses/nginx/*.log {
    dateext
	missingok
	notifempty
	rotate 10
    weekly
	compress
	delaycompress
	sharedscripts
	postrotate
		cd /srv/apps/comses && docker compose exec -T nginx nginx -s reopen
	endscript
}
